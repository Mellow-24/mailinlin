{
    email {$ACME_EMAIL}
    default_sni {$VOICE_DEMO_HOST}
    servers {
        protocols h1 h2 h3
        timeouts {
            read_body 60s
            read_header 30s
            idle 3600s
        }
    }
}

https://{$VOICE_DEMO_HOST} {
    # Let's Encrypt requires its short-lived profile for public IP address
    # certificates. Caddy renews these certificates automatically.
    tls {
        issuer acme {
            profile shortlived
        }
    }

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "camera=(), geolocation=()"
    }

    reverse_proxy gateway:80
}
