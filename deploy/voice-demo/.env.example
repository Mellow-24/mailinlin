# Public address. Until a dedicated domain exists, use <public-ip>.sslip.io.
VOICE_DEMO_HOST=203.0.113.10.sslip.io
SERVER_IP=203.0.113.10

# Only loopback is published, so this does not conflict with other apps.
VOICE_DEMO_LOCAL_PORT=18080
ACME_EMAIL=littermore@163.com

# Generate all values below with: ./deploy/voice-demo/generate-env.sh
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
TURN_SECRET=replace-me
OSS_JWT_SECRET=replace-me

# Created by scripts/provision_yishui_voice_demo.py or copied from the current
# working demo database/configuration. Never commit the real value.
YISHUI_VOICE_DEMO_TOKEN=replace-me

# Optional overrides
DOGRAH_API_IMAGE=ghcr.io/dograh-hq/dograh-api:latest
LOG_LEVEL=INFO
FORCE_TURN_RELAY=false
